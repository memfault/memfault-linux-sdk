software = {
    version = "__MEMFAULT_SOFTWARE_VERSION";

    __MEMFAULT_HARDWARE_VERSION = {
        hardware-compatibility: [ "1.0" ];
        stable: {
            copy1: {
                images: (
                    {
                        filename = "__ROOTFS_IMAGE";
                        type = "raw";
                        compressed = "zlib";
                        device = "/dev/__OTA_PARTITION_A";
                    }
                );
                uboot: (
                    {
                        name = "rootpart";
                        value = "2";
                    }
                );
            }

            copy2: {
                images: (
                    {
                        filename = "__ROOTFS_IMAGE";
                        type = "raw";
                        compressed = "zlib";
                        device = "/dev/__OTA_PARTITION_B";
                    }
                );
                uboot: (
                    {
                        name = "rootpart";
                        value = "3";
                    }
                );
            }
        }
    }
}
